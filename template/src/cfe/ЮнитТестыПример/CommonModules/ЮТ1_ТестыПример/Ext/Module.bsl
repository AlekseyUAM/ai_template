
#Область ПрограммныйИнтерфейс

// Возвращает список имён функций-сценариев тестирования данного модуля.
//
// Возвращаемое значение:
//  Массив из Строка - имена экспортных функций-сценариев для прогона.
//
Функция Сценарии() Экспорт

	Результат = Новый Массив;

	Результат.Добавить("СложениеЧисел");

	Возврат Результат;

КонецФункции

// Сценарий: проверяет корректность сложения двух чисел.
//
// Возвращаемое значение:
//  Булево - Истина, если сценарий пройден; иначе Ложь.
//
Функция СложениеЧисел() Экспорт

	Возврат Сложение(1, 1) = 2;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Складывает два числа.
//
// Параметры:
//  Число1 - Число - первое слагаемое.
//  Число2 - Число - второе слагаемое.
//
// Возвращаемое значение:
//  Число - сумма слагаемых.
//
Функция Сложение(Число1, Число2)

	Возврат Число1 + Число2;

КонецФункции

#КонецОбласти
