{
  "$schema": "https://1c-syntax.github.io/bsl-language-server/configuration/schema.json",
  "language": "ru",
  "diagnostics": {
    "minimumLSPDiagnosticLevel": "Information",
    "parameters": {
      "LineLength": {
        "maxLineLength": 160
      },
      "CognitiveComplexity": {
        "complexityThreshold": 30,
        "checkModuleBody": true
      },
      "CyclomaticComplexity": {
        "complexityThreshold": 40,
        "checkModuleBody": true
      }
    }
  }
}