# code-index-guard hook config (Python port).
# In a deployed project the file is generated automatically when the environment
# is created/updated; this sample is for manual deployment of the template.
#
# mcp_prefix - how the code-index server tools are named in this session.
# max_denies - how many times in a row the same native call may be denied
#   before it is allowed (protects local models from looping on deny;
#   0 - never yield).
# [[local]] - indexed repositories: path + alias (alias = repo= in calls).

mcp_prefix = "mcp__code_index__"
max_denies = 2

# [[local]]
# path = "C:/proj/src/cf"
# alias = "proj"

# Instead of [[local]] you can specify the indexer's daemon.toml:
# daemon_toml = "C:/tools/code-index/daemon.toml"
