///////////////////////////////////////////////////////////////////////////////////////////////////
// Расходная накладная. Списывает товары по ФИФО/ЛИФО согласно учетной политике организации
// и формирует обороты продаж (товары и услуги).
///////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

// Определяет сдвиг даты документа вперед относительно сохраненной в информационной базе.
//
// Признак ДатаДокументаСдвинутаВперед = Истина, если дата по ссылке
// (в информационной базе) меньше текущей даты документа. Определяется только при проведении
// уже проведенного документа. Признак передается в обработку проведения через структуру
// ДополнительныеСвойства и живет только в рамках записи документа.
//
// Параметры:
//  Отказ - Булево - признак отказа в записи документа.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ДатаДокументаСдвинутаВперед = Ложь;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И НЕ ЭтоНовый()
		И Проведен Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасходнаяНакладная.Дата КАК Дата
			|ИЗ
			|	Документ.РасходнаяНакладная КАК РасходнаяНакладная
			|ГДЕ
			|	РасходнаяНакладная.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			ДатаДокументаСдвинутаВперед = Выборка.Дата < Дата;
		КонецЕсли;

	КонецЕсли;

	ДополнительныеСвойства.Вставить("ДатаДокументаСдвинутаВперед", ДатаДокументаСдвинутаВперед);

КонецПроцедуры

// Формирует движения по регистрам накопления Товары и Продажи.
//
// В обработке выполняется ровно один запрос: строки табличной части группируются по номенклатуре,
// остатки партий читаются на момент документа (исключая собственные движения), результат
// обходится по номенклатуре, внутри - по партиям в порядке ФИФО или ЛИФО.
//
// Параметры:
//  Отказ - Булево - признак отказа в проведении документа.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.Товары.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

	// Признак сдвига даты вычислил ПередЗаписью и передал через структуру ДополнительныеСвойства.
	// Отсутствие ключа или значение, отличное от Истина, трактуются как Ложь.
	ДатаДокументаСдвинутаВперед = Ложь;   
	Если ДополнительныеСвойства.Свойство("ДатаДокументаСдвинутаВперед") Тогда
		ДатаДокументаСдвинутаВперед = ДополнительныеСвойства.ДатаДокументаСдвинутаВперед;
	КонецЕсли;

	// При сдвиге даты вперед старые движения на прежней дате не должны попасть в остатки:
	// записываем пустые наборы, чтобы удаление стало видно последующему запросу.
	Если ДатаДокументаСдвинутаВперед Тогда

		Движения.Записать();

		// Движения.Записать() сбрасывает признак Записывать: возвращаем его, иначе
		// новые движения не запишутся.
		Движения.Товары.Записывать = Истина;
		Движения.Продажи.Записывать = Истина;

	КонецЕсли;

	ДанныеУчетнойПолитики = РегламентированныйУчетПовтИсп.ДанныеУчетнойПолитики(Дата, Организация);

	Если ДанныеУчетнойПолитики.МетодСписанияСебестоимости = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не задана учетная политика для организации %1 на дату %2", Организация, Формат(Дата, "ДЛФ=D")) ,,,, Отказ);
		Возврат;
	КонецЕсли;

	// Блокировка остатков регистра Товары до чтения: сумма списания зависит от остатков партий.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.Товары");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = СписокНоменклатуры;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСписания(ДанныеУчетнойПолитики.МетодСписанияСебестоимости);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаПоНоменклатуре = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаПоНоменклатуре.Следующий() Цикл

		ТекущаяНоменклатура = ВыборкаПоНоменклатуре.Номенклатура;
		ЭтоУслуга = ВыборкаПоНоменклатуре.Услуга;
		КоличествоКСписанию = ВыборкаПоНоменклатуре.Количество;
		СуммаСтроки = ВыборкаПоНоменклатуре.Сумма;
		КоличествоСписано = 0;
		СтоимостьСписано = 0;

		Если Не ЭтоУслуга Тогда

			СписатьПоПартиям(
				ВыборкаПоНоменклатуре.Выбрать(),
				ТекущаяНоменклатура,
				КоличествоКСписанию,
				КоличествоСписано,
				СтоимостьСписано);

			Если КоличествоСписано < КоличествоКСписанию Тогда
				НеХватает = КоличествоКСписанию - КоличествоСписано;
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон("Недостаточно остатка по номенклатуре %1. Не хватает %2.", ТекущаяНоменклатура, НеХватает) ,,,, Отказ);
				Возврат;
			КонецЕсли;

		КонецЕсли;

		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;
		ДвижениеПродажи.Организация = Организация;
		ДвижениеПродажи.Номенклатура = ТекущаяНоменклатура;
		ДвижениеПродажи.Количество = КоличествоКСписанию;
		ДвижениеПродажи.Стоимость = СтоимостьСписано;
		ДвижениеПродажи.Сумма = СуммаСтроки;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Списывает количество товара по партиям в порядке их следования в выборке.
//
// Стоимость списания по партии рассчитывается пропорционально списываемому количеству
// от стоимости остатка партии. Накопленные количества и стоимость возвращаются через параметры.
//
// Параметры:
//  ВыборкаПоПартиям - ВыборкаИзРезультатаЗапроса - детальные записи партий текущей номенклатуры.
//  Номенклатура - СправочникСсылка.Номенклатура - списываемая номенклатура.
//  КоличествоКСписанию - Число - требуемое количество.
//  КоличествоСписано - Число - количество, списанное по обработанным партиям (изменяется).
//  СтоимостьСписано - Число - стоимость, списанная по обработанным партиям (изменяется).
//
Процедура СписатьПоПартиям(ВыборкаПоПартиям, Номенклатура, КоличествоКСписанию, КоличествоСписано, СтоимостьСписано)

	Пока ВыборкаПоПартиям.Следующий() Цикл

		Осталось = КоличествоКСписанию - КоличествоСписано;

		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;

		КоличествоОстаток = ВыборкаПоПартиям.КоличествоОстаток;

		Если КоличествоОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоПартии = Мин(Осталось, КоличествоОстаток);
		СтоимостьПартии = ВыборкаПоПартиям.СтоимостьОстаток * КоличествоПартии / КоличествоОстаток;

		Движение = Движения.Товары.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Номенклатура = Номенклатура;
		Движение.Партия = ВыборкаПоПартиям.Партия;
		Движение.Количество = КоличествоПартии;
		Движение.Стоимость = СтоимостьПартии;

		КоличествоСписано = КоличествоСписано + КоличествоПартии;
		СтоимостьСписано = СтоимостьСписано + СтоимостьПартии;

	КонецЦикла;

КонецПроцедуры

// Возвращает текст запроса списания товаров по партиям.
//
// Порядок партий задается в тексте запроса: ФИФО - от более ранней к более поздней,
// ЛИФО - от более поздней к более ранней. Порядок определяется моментом времени партии;
// так как момент времени однозначно определяется датой и ссылкой, сортировка по дате
// и ссылке партии эквивалентна сортировке по моменту времени.
//
// Параметры:
//  МетодСписания - ПеречислениеСсылка.МетодСписанияСебестоимости - метод списания.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаСписания(МетодСписания)
	
	ТекстЗапроса = ТекстЗапросаСписанияПоПартиям();	
	
	Если МетодСписания = Перечисления.МетодСписанияСебестоимости.ФИФО Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПорядокПоМетодуСписания", "ВТОстатки.Партия.МоментВремени");	 
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПорядокПоМетодуСписания", "ВТОстатки.Партия.МоментВремени УБЫВ");		
				
	КонецЕсли; 
	
	Возврат ТекстЗапроса;  

КонецФункции

// Возвращает текст запроса списания товаров по партиям.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаСписанияПоПартиям()

	Возврат
		"ВЫБРАТЬ
		|	СтрокиДокумента.Номенклатура КАК Номенклатура,
		|	СУММА(СтрокиДокумента.Количество) КАК Количество,
		|	СУММА(СтрокиДокумента.Сумма) КАК Сумма,
		|	МАКСИМУМ(СпрНоменклатура.Услуга) КАК Услуга
		|ПОМЕСТИТЬ ВТСтроки
		|ИЗ
		|	Документ.РасходнаяНакладная.СписокНоменклатуры КАК СтрокиДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|			ПО СтрокиДокумента.Номенклатура = СпрНоменклатура.Ссылка
		|ГДЕ
		|	СтрокиДокумента.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	СтрокиДокумента.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваров.Партия КАК Партия,
		|	ОстаткиТоваров.КоличествоОстаток КАК КоличествоОстаток,
		|	ОстаткиТоваров.СтоимостьОстаток КАК СтоимостьОстаток
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	РегистрНакопления.Товары.Остатки(
		|			&Момент,
		|			Организация = &Организация
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ВТСтрокиТоваров.Номенклатура КАК Номенклатура
		|					ИЗ
		|						ВТСтроки КАК ВТСтрокиТоваров
		|					ГДЕ
		|						НЕ ВТСтрокиТоваров.Услуга)) КАК ОстаткиТоваров
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСтроки.Номенклатура КАК Номенклатура,
		|	ВТСтроки.Услуга КАК Услуга,
		|	ВТСтроки.Количество КАК Количество,
		|	ВТСтроки.Сумма КАК Сумма,
		|	ЕСТЬNULL(ВТОстатки.Партия, Неопределено) КАК Партия,
		|	ЕСТЬNULL(ВТОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(ВТОстатки.СтоимостьОстаток, 0) КАК СтоимостьОстаток
		|ИЗ
		|	ВТСтроки КАК ВТСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
		|			ПО ВТСтроки.Номенклатура = ВТОстатки.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	&ПорядокПоМетодуСписания
		|
		|ИТОГИ
		|	МАКСИМУМ(Услуга),
		|	МАКСИМУМ(Количество),
		|	МАКСИМУМ(Сумма)
		|ПО
		|	Номенклатура";

КонецФункции

#КонецОбласти
