# Пример конфигурации benchmark-окружения.
# Скопируйте в benchmark/test.env и заполните своими значениями:
#
#     cp benchmark/example.test.env benchmark/test.env
#
# Реальный test.env не коммитится (см. .gitignore) и содержит пароль 1С.

# ─── Проект ───────────────────────────────────────────────────────────────────
BENCH_PROJECT_NAME=bench
# local: каталог на хосте; docker: путь внутри контейнера (обычно /workspace —
# проект живёт в томе контейнера, файлов на хосте нет).
BENCH_PROJECT_DIR=/home/uam/projects/bench
BENCH_DEVELOPER_ID=alex
BENCH_DEVELOPER_EMAIL=alex@example.ru

# ─── Размещение проекта ───────────────────────────────────────────────────────
# local  — проект на хосте (setup и агент запускаются локально);
# docker — установка и агент работают в Docker-контейнере образа агента.
# Каталог BENCH_PROJECT_DIR монтируется в контейнер по тому же пути, поэтому
# git, code-index и анализаторы остаются доступны с хоста. localhost в
# BENCH_DB_CONNECTION и MCP-URL для контейнера заменяется на
# host.docker.internal автоматически.
BENCH_PLACEMENT=local
# Образ для docker; по умолчанию ai1c-agent:<версия из BENCH_PLATFORM_PATH>.
#BENCH_DOCKER_IMAGE=ai1c-agent:8.3.27.2130

# ─── Агент ───────────────────────────────────────────────────────────────────
# Команда запуска агента для run_benchmark.py/stage_run.py (обязательна).
# --claude-cmd на командной строке переопределяет. Варианты:
#   claude-ds, claude-local, claude --dangerously-skip-permissions
# Для запуска через AgentMon Web UI задайте то же значение в .ai1c.env.
AGENTMON_CLAUDE_CMD=claude-ds

# ─── Локальная LLM (Strata) ──────────────────────────────────────────────────
# 1 — setup_benchmark.py возьмёт настройки у `strata connect claude-code`
# и запишет <проект>/.claude/settings.local.json. 0/не задано — не трогать.
BENCH_STRATA_SETTINGS=0
# Путь к CLI Strata, если её нет в PATH (см. deploy/claude/README.md).
#STRATA_CMD=C:\Users\user\AppData\Local\Strata\terminal\current\bin\strata.cmd

# ─── Платформа и база 1С ──────────────────────────────────────────────────────
# Каталог платформы или сам бинарник 1cv8.
BENCH_PLATFORM_PATH=/opt/1cv8/x86_64/8.3.27.2130/1cv8
# Серверная: Srvr=host;Ref=base. Файловая: путь к каталогу ИБ.
BENCH_DB_CONNECTION=Srvr=localhost;Ref=bench
BENCH_DB_USER=Администратор
BENCH_DB_PASSWORD=

# ─── MCP ──────────────────────────────────────────────────────────────────────
# Общие серверы (обязательны).
MCP_BSL_LS_URL=http://localhost:8001/mcp
MCP_1C_PLATFORM_URL=http://localhost:8002/sse
# Порт нативного code_index (обязателен); хост по умолчанию localhost.
MCP_CODE_INDEX_PORT=8004
#MCP_CODE_INDEX_HOST=localhost
# Таймаут ожидания полной индексации, минуты (по умолчанию 360).
#CODE_INDEX_WAIT_MINUTES=360

# ─── Нативный code-index ──────────────────────────────────────────────────────
# Каталог нативного code-index (бинарь, daemon.toml, PID, логи).
# При каждом setup удаляется и создаётся заново — не указывайте общий
# каталог другого сервиса. Windows: D:\projects\bench-code-index
# docker: это путь ВНУТРИ контейнера (именованный том), например /code-index.
CODE_INDEX_DIR=/home/uam/projects/bench-code-index

# ─── Опционально ──────────────────────────────────────────────────────────────
# URL http-сервиса 1c-md в базе; если не задан — MCP-сервер не подключается.
#MCP_1C_MD_URL=http://localhost/bench/hs/mcp
# URL общего MCP 1С:Напарник; если не задан — сервер не подключается.
# Токен Напарника настроен на стороне сервера, в test.env его нет.
#MCP_1C_NAPARNIC_URL=http://localhost:8003/mcp
# Локальный путь к .dt. Если задан — benchmark/cf и расширения НЕ загружаются.
#BENCH_DT_PATH=/home/uam/backups/bench.dt
