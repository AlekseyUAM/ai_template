#!/usr/bin/env sh
# Скопируйте в корень benchmark-проекта как claude-local.sh:
#   cp benchmark/claude-local.sh.example <проект>/claude-local.sh
#   chmod +x <проект>/claude-local.sh
# Настройки локальной LLM (адрес, токен, модель, лимиты контекста) берутся
# из .claude/settings.local.json — см. .claude/settings.local.json.example.
set -eu
cd "$(dirname "$0")"
# Не тащим Anthropic-окружение из внешних запусков.
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
unset ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
exec claude --dangerously-skip-permissions "$@"
