# Пример конфигурации Agent Monitor (.ai1c.env).
#
# Файл .ai1c.env читается скриптом run.py при запуске (`python run.py`) и задаёт
# окружение монитора. Скопируйте этот пример и при необходимости отредактируйте:
#
#   cp .ai1c.env.example .ai1c.env
#
# `python bootstrap.py` генерирует .ai1c.env автоматически (AGENTMON_DSN/AGENTMON_DB +
# AI1C_PG_MODE). Этот пример нужен, чтобы вручную поменять параметры или
# развернуть монитор без bootstrap. Формат: KEY=value, строки с # — комментарии.
#
# Примечание: параметры docker-/ssh-бэкендов ПРОЕКТА (удалённый хост, docker-демон,
# образ) задаются в мастере создания проекта, а не здесь. .ai1c.env — это настройки
# самого монитора (control plane).


# ─── База данных ──────────────────────────────────────────────────────────────
# Как bootstrap.py разворачивает PostgreSQL:
#   host   — ПОРТАТИВНАЯ PG прямо на хосте (по умолчанию): bootstrap скачивает
#            портативную сборку PG в .ai1c/pg, initdb в .ai1c/pgdata, поднимает
#            через pg_ctl и создаёт роль/БД ai1c. Без Docker и админ-прав —
#            актуально для Windows без Docker. run.py поднимает её при старте,
#            если не запущена.
#   docker — PG в контейнере ai1c-postgres (deploy/postgres).
# При сбое разворачивания — фолбэк на локальный SQLite.
AI1C_PG_MODE=host
# Строка подключения. Обычно пишется автоматически bootstrap.py.
AGENTMON_DSN=postgresql://ai1c:ai1c@127.0.0.1:5432/ai1c
# Путь к файлу SQLite (fallback, если PostgreSQL недоступна).
AGENTMON_DB=app/agentmon.db


# ─── HTTP-сервер ────────────────────────────────────────────────────────────────
# Адрес и порт Web UI.
#AGENTMON_HOST=127.0.0.1
#AGENTMON_PORT=8765


# ─── Запуск агента ──────────────────────────────────────────────────────────────
# Команда запуска claude. Переопределяется и в настройках проекта.
#AGENTMON_CLAUDE_CMD=claude --dangerously-skip-permissions .


# ─── Telegram-интеграция (опционально) ──────────────────────────────────────────
# Пусто/не задан токен → фича выключена (ни бот, ни нотификатор не стартуют).
#AGENTMON_TG_TOKEN=123456:AA...
# Разрешённые chat_id через запятую (чужие чаты игнорируются).
#AGENTMON_TG_CHAT_IDS=111111111,222222222
# База Telegram Bot API (обычно менять не нужно).
#AGENTMON_TG_API_BASE=https://api.telegram.org
